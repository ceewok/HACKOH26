# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS / deploy ---
# Optional for a named AWS CLI or SSO profile, e.g. AWS_PROFILE=your-profile.
# Set AWS_SDK_LOAD_CONFIG=1 when the profile configuration lives in ~/.aws/config.
AWS_REGION=us-east-2

# --- DynamoDB ---
# Table name used by the backend (local + deployed).
TABLE_NAME=bridge-builder
# For local dev against DynamoDB Local, point the SDK at the local endpoint.
# Leave DYNAMODB_ENDPOINT unset when running against real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# Active inference profile verified in us-east-2. Authentication comes
# from your AWS CLI/profile/environment — never add access keys here.
# Nova is the default because it needs no AWS Marketplace subscription; Claude
# profiles (e.g. us.anthropic.claude-haiku-4-5-20251001-v1:0) require one.
# Optional: a temporary Bedrock API key. When supplied, the backend prefers this
# bearer token over AWS profile credentials. Keep the value only in your .env.
# AWS_BEARER_TOKEN_BEDROCK=your-temporary-bedrock-api-key
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_REGION=us-east-2

# --- Local backend ---
PORT=4000
