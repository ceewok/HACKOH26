# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS / deploy ---
AWS_REGION=us-east-1

# --- DynamoDB ---
# Table name used by the backend (local + deployed).
TABLE_NAME=bridge-builder
# For local dev against DynamoDB Local, point the SDK at the local endpoint.
# Leave DYNAMODB_ENDPOINT unset when running against real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Amazon Bedrock (POST /ai/diagram) ---
# Model or inference-profile ID enabled in BEDROCK_REGION. If the model requires
# a cross-region inference profile, use its supported prefixed profile ID.
# Authentication comes from your AWS CLI/profile/environment — never add access keys here.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# --- Local backend ---
PORT=4000
