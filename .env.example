# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS / deploy ---
# Optional for a named AWS CLI or SSO profile, e.g. AWS_PROFILE=your-profile.
# Set AWS_SDK_LOAD_CONFIG=1 when the profile configuration lives in ~/.aws/config.
AWS_REGION=us-east-2

# --- DynamoDB ---
# Table name used by the backend (local + deployed).
TABLE_NAME=bridge-builder
# For local dev against DynamoDB Local, point the SDK at the local endpoint.
# Leave DYNAMODB_ENDPOINT unset when running against real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Amazon Bedrock (POST /ai/diagram) ---
# Active Haiku inference profile verified in us-east-2. Authentication comes
# from your AWS CLI/profile/environment — never add access keys here.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-2

# --- Local backend ---
PORT=4000
